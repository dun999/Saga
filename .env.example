# Walrus Memory credentials — create a mainnet account + delegate key at https://memory.walrus.xyz
MEMWAL_PRIVATE_KEY=suiprivkey1...        # or 64-hex Ed25519 seed; server-side only, never sent to browsers
MEMWAL_ACCOUNT_ID=0x...                  # MemWalAccount object id
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Optional API-backed agents (see saga.json)
# XAI_API_KEY=
# OPENROUTER_API_KEY=

# Sign-in with Sui (wallet) gates the web app; your Sui address is your Saga identity.
# SAGA_AUTH=off                  # single-user local runs without sign-in
# SAGA_SESSION_SECRET=           # keeps sessions valid across restarts (random per process if unset)
# SAGA_ALLOWED_ADDRESSES=0x…,0x… # optional allowlist; required (or SAGA_ACCESS_CODE) to bind a public host

# Whose provider accounts run the agents:
#   host = the operator's own Claude/Codex/Grok logins (default when serving on localhost)
#   user = every user connects their own (Claude token or API key, ChatGPT/Grok device sign-in, or ＋ API);
#          each user's agents run in a bubblewrap sandbox (default when serving on a public host)
# SAGA_ACCOUNTS=user
# SAGA_HOMES=agent-homes          # per-user agent homes (their provider logins live here, 0700)

# GitHub: users connect with a fine-grained token, or — if you register a GitHub OAuth App with
# "Enable Device Flow" — with "Sign in with GitHub" (device code). Only the client id is needed.
# SAGA_GITHUB_CLIENT_ID=

# Web
# SAGA_HOST=127.0.0.1
# SAGA_PORT=8080
# SAGA_ACCESS_CODE=      # required when binding a public interface
# SAGA_EVOLVE_EVERY=3    # 👎 critiques before the system prompt mutates
# SAGA_AGENT_TIMEOUT=900
