# Secrets only. Everything else is a flag (`saga` prints them) or a built-in default.

# Walrus Memory: create a mainnet account + delegate key at https://memory.walrus.xyz
MEMWAL_PRIVATE_KEY=suiprivkey1...        # or 64-hex Ed25519 seed; server-side only, never sent to browsers
MEMWAL_ACCOUNT_ID=0x...                  # MemWalAccount object id
# MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz   # only to use a different relayer

# Saga's own default agent (@saga), free for every user: Boundless inference (OpenAI-compatible).
# Get a key at https://inference.boundless.network
BOUNDLESS_API_KEY=

# Optional. "Connect GitHub" via an OAuth App (https://github.com/settings/developers), callback URL
# <your Saga URL>/api/github/callback. Without it, users can still paste a fine-grained token.
# SAGA_GITHUB_CLIENT_ID=
# SAGA_GITHUB_CLIENT_SECRET=
