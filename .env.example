# Secrets only. Everything else is a flag (`saga` prints them) or a built-in default.
# Leave a value empty until you have a real key.
# Put nothing after the value. Saga keeps every character after "=", including a # comment.

# Walrus Memory. Create a mainnet account and delegate key at https://memory.walrus.xyz
# MEMWAL_PRIVATE_KEY is a suiprivkey1... bech32 key or a 64-hex Ed25519 seed. Server-side only.
MEMWAL_PRIVATE_KEY=
# MemWalAccount object id.
MEMWAL_ACCOUNT_ID=

# Optional. Set this only to use a different relayer.
# MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Built-in @saga assistant (OpenAI-compatible Boundless inference).
# Create a key at https://inference.boundless.network
BOUNDLESS_API_KEY=

# Optional GitHub OAuth App: https://github.com/settings/developers
# Callback URL: <your Saga URL>/api/github/callback
# Without these, a user can still paste a fine-grained token.
# SAGA_GITHUB_CLIENT_ID=
# SAGA_GITHUB_CLIENT_SECRET=
