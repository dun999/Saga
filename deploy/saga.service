# Edit the public host and install paths before use. Requires systemd >= 254 and cgroup v2.
# Create a dedicated `saga` account and keep its data on a filesystem with a disk quota.
[Unit]
Description=Saga
After=network-online.target
Wants=network-online.target

[Service]
User=saga
Group=saga
WorkingDirectory=/var/lib/saga
StateDirectory=saga
StateDirectoryMode=0700
Environment=HOME=/var/lib/saga
EnvironmentFile=-/etc/saga/saga.env
UMask=0077
Delegate=cpu memory pids
DelegateSubgroup=server
MemoryMax=6G
TasksMax=512
ExecStart=/usr/local/bin/saga serve --host 127.0.0.1 --port 8080 --accounts user --wallet-only --public-origin https://usesaga.xyz --trust-proxy --agent-cgroups /sys/fs/cgroup/system.slice/saga.service/agents
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
