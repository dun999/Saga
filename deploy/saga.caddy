# Caddy site for Saga. Save as /etc/caddy/saga.caddy, add `import /etc/caddy/saga.caddy` to the
# Caddyfile, then `caddy validate --config /etc/caddy/Caddyfile` and `systemctl reload caddy`.
# Saga gzips its own pages; no encode here, so the NDJSON chat stream and the SSE write feed are
# passed through as they are written.
usesaga.xyz {
	# Private test deployment. Make the hash with `caddy hash-password`; remove this block to open the site.
	# (Caddy 2.8 and newer also accept the spelling `basic_auth`.)
	basicauth {
		saga <bcrypt hash from caddy hash-password>
	}
	reverse_proxy 127.0.0.1:8090 {
		flush_interval -1
	}
}

www.usesaga.xyz {
	redir https://usesaga.xyz{uri} permanent
}
